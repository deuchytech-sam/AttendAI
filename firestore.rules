rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(universityId) {
      return /databases/$(database)/documents/universities/$(universityId)/members/$(request.auth.uid);
    }

    function memberPathFor(universityId, uid) {
      return /databases/$(database)/documents/universities/$(universityId)/members/$(uid);
    }

    function coursePath(universityId, courseId) {
      return /databases/$(database)/documents/universities/$(universityId)/courses/$(courseId);
    }

    function sessionPath(universityId, sessionId) {
      return /databases/$(database)/documents/universities/$(universityId)/attendanceSessions/$(sessionId);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function adminCanReadMemberProfile(uid) {
      return signedIn()
        && (
          (
            request.auth.token.get('universityAdmin', false) == true
            && request.auth.token.get('universityId', '') is string
            && request.auth.token.get('universityId', '') != ''
            && isUniversityAdmin(request.auth.token.get('universityId', ''))
            && exists(memberPathFor(
              request.auth.token.get('universityId', ''),
              uid
            ))
            && get(memberPathFor(
              request.auth.token.get('universityId', ''),
              uid
            )).data.status == 'active'
          )
          || (
            get(userPath(request.auth.uid)).data.keys().hasAny(['universityId'])
            && get(userPath(request.auth.uid)).data.universityId is string
            && isUniversityAdmin(get(userPath(request.auth.uid)).data.universityId)
            && exists(memberPathFor(
              get(userPath(request.auth.uid)).data.universityId,
              uid
            ))
            && get(memberPathFor(
              get(userPath(request.auth.uid)).data.universityId,
              uid
            )).data.status == 'active'
          )
        );
    }

    function lecturerAssignedToCourse(universityId, courseId) {
      // Use the current course document so reassignment takes effect immediately.
      // This costs one course-document rules read per session/record request;
      // copied session assignments could become stale after a mid-semester change.
      return courseId is string
        && hasRole(universityId, 'lecturer')
        && exists(coursePath(universityId, courseId))
        && get(coursePath(universityId, courseId)).data.keys().hasAny(['lecturerIds'])
        && get(coursePath(universityId, courseId)).data.lecturerIds is list
        && request.auth.uid in get(coursePath(universityId, courseId)).data.lecturerIds;
    }

    function studentEnrolledInCourse(universityId, courseId) {
      return courseId is string
        && hasRole(universityId, 'student')
        && get(memberPath(universityId)).data.courseIds is list
        && get(memberPath(universityId)).data.courseIds.hasAny([courseId]);
    }

    // Legacy records may lack courseId. Resolve it through immutable sessionId
    // so existing attendance records remain readable without rewriting them.
    function attendanceRecordCourseId(universityId) {
      return (resource.data.keys().hasAny(['courseId'])
        && resource.data.courseId is string)
        ? resource.data.courseId
        : get(sessionPath(universityId, resource.data.sessionId)).data.courseId;
    }

    function isActiveLecturer(universityId, uid) {
      return exists(memberPathFor(universityId, uid))
        && get(memberPathFor(universityId, uid)).data.status == 'active'
        && get(memberPathFor(universityId, uid)).data.role == 'lecturer';
    }

    function activeLecturerAt(universityId, ids, index) {
      return ids.size() <= index
        || (ids[index] is string && isActiveLecturer(universityId, ids[index]));
    }

    // Firestore Rules do not support loops. Bound assignments so every UID can
    // be checked against its active university membership within access limits.
    function validLecturerIds(universityId, ids) {
      return ids is list
        && ids.size() <= 8
        && activeLecturerAt(universityId, ids, 0)
        && activeLecturerAt(universityId, ids, 1)
        && activeLecturerAt(universityId, ids, 2)
        && activeLecturerAt(universityId, ids, 3)
        && activeLecturerAt(universityId, ids, 4)
        && activeLecturerAt(universityId, ids, 5)
        && activeLecturerAt(universityId, ids, 6)
        && activeLecturerAt(universityId, ids, 7);
    }

    function isMember(universityId) {
      return signedIn()
        && exists(memberPath(universityId))
        && get(memberPath(universityId)).data.status == 'active';
    }

    function hasRole(universityId, role) {
      return isMember(universityId)
        && get(memberPath(universityId)).data.role == role;
    }

    function isUniversityAdmin(universityId) {
      return hasRole(universityId, 'admin');
    }

    match /users/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid
          || (resource.data.universityId is string
            && isUniversityAdmin(resource.data.universityId))
          || adminCanReadMemberProfile(uid));
      allow list: if signedIn()
        && resource.data.universityId is string
        && hasRole(resource.data.universityId, 'admin');
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'universityId',
          'requestedRole', 'matricNumber', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'displayName', 'universityId',
          'requestedRole', 'status', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.universityId is string
        && request.resource.data.universityId.size() > 0
        && request.resource.data.requestedRole in ['lecturer', 'student']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['matricNumber'])
          || request.resource.data.matricNumber == null
          || request.resource.data.matricNumber is string);
      allow update: if signedIn()
        && resource.data.universityId is string
        && isUniversityAdmin(resource.data.universityId)
        && resource.data.status == 'pending'
        && request.resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status'])
        && existsAfter(/databases/$(database)/documents/universities/$(resource.data.universityId)/members/$(uid))
        && getAfter(/databases/$(database)/documents/universities/$(resource.data.universityId)/members/$(uid)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/universities/$(resource.data.universityId)/members/$(uid)).data.role == resource.data.requestedRole;
      allow delete: if false;
    }

    match /universities/{universityId} {
      allow read: if isMember(universityId);
      allow write: if false;

      match /members/{uid} {
        allow read: if hasRole(universityId, 'lecturer')
          || isUniversityAdmin(universityId)
          || (signedIn() && request.auth.uid == uid);
        allow create: if isUniversityAdmin(universityId)
          && request.resource.data.keys().hasOnly([
            'status', 'role', 'courseIds', 'approvedBy', 'approvedAt',
            'displayName', 'email'
          ])
          && request.resource.data.keys().hasAll([
            'status', 'role', 'courseIds', 'approvedBy', 'approvedAt'
          ])
          && request.resource.data.status == 'active'
          && request.resource.data.role in ['student', 'lecturer']
          && request.resource.data.approvedBy == request.auth.uid
          && request.resource.data.approvedAt == request.time
          && request.resource.data.courseIds is list
          && (!request.resource.data.keys().hasAny(['displayName'])
            || request.resource.data.displayName is string)
          && (!request.resource.data.keys().hasAny(['email'])
            || request.resource.data.email is string)
          && exists(/databases/$(database)/documents/users/$(uid))
          && get(/databases/$(database)/documents/users/$(uid)).data.universityId == universityId
          && get(/databases/$(database)/documents/users/$(uid)).data.status == 'pending'
          && get(/databases/$(database)/documents/users/$(uid)).data.requestedRole == request.resource.data.role;
        // Allow user to update ONLY their own FCM token fields
        allow update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['fcmToken', 'tokenUpdatedAt'])
          && request.resource.data.fcmToken is string
          && request.resource.data.tokenUpdatedAt == request.time;
        allow delete: if false;
      }

      match /students/{studentId} {
        allow read: if isUniversityAdmin(universityId)
          || lecturerAssignedToCourse(universityId, resource.data.courseId)
          || (isMember(universityId)
            && resource.data.userId == request.auth.uid);
        allow create: if false;
        // Approval may attach the pending account to its matching roster row.
        // Keep this limited to adding (or retaining) that account's own UID.
        allow update: if isUniversityAdmin(universityId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['userId'])
          && request.resource.data.userId is string
          && request.resource.data.userId.size() > 0
          && (!resource.data.keys().hasAny(['userId'])
            || resource.data.userId == request.resource.data.userId)
          && existsAfter(/databases/$(database)/documents/users/$(request.resource.data.userId))
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.universityId == universityId
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.status == 'approved'
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.requestedRole == 'student'
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.keys().hasAny(['matricNumber'])
          && getAfter(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.matricNumber == resource.data.matricNumber
          && existsAfter(/databases/$(database)/documents/universities/$(universityId)/members/$(request.resource.data.userId))
          && getAfter(/databases/$(database)/documents/universities/$(universityId)/members/$(request.resource.data.userId)).data.status == 'active'
          && getAfter(/databases/$(database)/documents/universities/$(universityId)/members/$(request.resource.data.userId)).data.role == 'student';
        allow delete: if false;
      }

      match /courses/{courseId} {
        allow get: if isUniversityAdmin(universityId)
          || (hasRole(universityId, 'lecturer')
            && resource.data.lecturerIds is list
            && resource.data.lecturerIds.hasAny([request.auth.uid]))
          || studentEnrolledInCourse(universityId, resource.data.id);
        allow list: if isUniversityAdmin(universityId)
          || (signedIn()
            && request.auth.uid in resource.data.lecturerIds);
        allow create: if (isUniversityAdmin(universityId)
            && request.resource.data.keys().hasOnly([
              'id', 'name', 'lecturer', 'lecturerIds', 'schedule', 'createdBy', 'createdAt'
            ])
            && request.resource.data.keys().hasAll([
              'id', 'name', 'lecturer', 'lecturerIds', 'schedule', 'createdBy', 'createdAt'
            ])
            && request.resource.data.id == courseId
            && request.resource.data.name is string
            && request.resource.data.lecturer is string
            && validLecturerIds(universityId, request.resource.data.lecturerIds)
            && request.resource.data.schedule is string
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time);
        allow update: if isUniversityAdmin(universityId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'schedule', 'lecturerIds'])
          && request.resource.data.name is string
          && request.resource.data.schedule is string
          && validLecturerIds(universityId, request.resource.data.lecturerIds);
        allow delete: if false;
      }

      match /attendanceSessions/{sessionId} {
        allow read: if isUniversityAdmin(universityId)
          || lecturerAssignedToCourse(universityId, resource.data.courseId)
          || studentEnrolledInCourse(universityId, resource.data.courseId);
        allow create: if lecturerAssignedToCourse(universityId, request.resource.data.courseId)
          && request.resource.data.keys().hasOnly([
            'id', 'courseId', 'status', 'openedBy', 'openedAt'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'courseId', 'status', 'openedBy', 'openedAt'
          ])
          && request.resource.data.id == sessionId
          && request.resource.data.status == 'open'
          && request.resource.data.openedBy == request.auth.uid
          && request.resource.data.openedAt == request.time;
        allow update: if lecturerAssignedToCourse(universityId, resource.data.courseId)
          && resource.data.status == 'open'
          && request.resource.data.status == 'closed'
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'closedAt'])
          && request.resource.data.closedAt == request.time;
        allow delete: if false;
      }

      match /attendanceRecords/{recordId} {
        allow read: if isUniversityAdmin(universityId)
          || lecturerAssignedToCourse(
            universityId,
            attendanceRecordCourseId(universityId)
          )
          || (hasRole(universityId, 'student')
            && resource.data.studentUid == request.auth.uid
          );
        allow write: if false;
      }

      match /biometricProfiles/{studentId} {
        // Students can read their own biometric profile for face verification
        allow get: if signedIn() && request.auth.uid == studentId;
        allow list: if false;
        // Only system/admin can create/update biometric profiles (via Cloud Functions)
        allow create, update: if false;
        allow delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if hasRole(universityId, 'lecturer');
        allow write: if false;
      }

      match /faceEmbeddings/{userId} {
        // Students can read and write ONLY their own face embeddings document
        allow get: if signedIn() && request.auth.uid == userId;
        allow list: if false;
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'faceId', 'studentId', 'embeddings', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'faceId', 'studentId', 'embeddings', 'updatedAt'
          ])
          && request.resource.data.faceId == userId
          && request.resource.data.studentId == userId
          && request.resource.data.embeddings is list
          && request.resource.data.updatedAt == request.time;
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'faceId', 'studentId', 'embeddings', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'faceId', 'studentId', 'embeddings', 'updatedAt'
          ])
          && request.resource.data.faceId == userId
          && request.resource.data.studentId == userId
          && request.resource.data.embeddings is list
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == userId;
      }
    }
  }
}
